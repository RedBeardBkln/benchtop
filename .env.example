# Copy to .env.local and fill in. Never commit real values.
# `next build` does NOT require any of the Stripe / service-role values below; features that need
# a missing value degrade gracefully (see README "Outside users / required environment").

# ── Database (Postgres; Supabase in production) ──────────────────────────────
# Transaction pooler URL (port 6543) for the running app.
DATABASE_URL=
# Direct URL (port 5432) used by drizzle-kit; falls back to DATABASE_URL when empty.
DIRECT_URL=

# ── Supabase (auth + storage) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Needed for: invite redemption (creates the login),
# document upload/download/delete/parse, account deletion, and `pnpm db:bootstrap`.
SUPABASE_SERVICE_ROLE_KEY=

# ── Public app URL ───────────────────────────────────────────────────────────
# Used for invite links and Stripe return URLs, e.g. https://benchtop.example.com
# Optional: when empty the request origin is used (works behind Vercel).
NEXT_PUBLIC_APP_URL=

# ── Platform admins (who may create invitations) ─────────────────────────────
# Comma-separated, case-insensitive. Applied by `pnpm db:bootstrap --apply` (without --apply the
# script is a dry run that only prints what it would change).
PLATFORM_ADMIN_EMAILS=

# ── Stripe billing (use TEST mode keys outside production) ───────────────────
STRIPE_SECRET_KEY=
# Price ids (price_...) of the subscription plan, billed monthly ($25) or yearly ($250).
STRIPE_PLAN_PRICE_MONTHLY_ID=
STRIPE_PLAN_PRICE_YEARLY_ID=
# Extra team seats (every member besides the owner), billed on the same subscription. Stripe needs
# all items on a subscription to share an interval, so the seat price used follows the plan's:
# a recurring $10/month price and a recurring $100/year price. Without both, teams can't be grown.
STRIPE_SEAT_PRICE_MONTHLY_ID=
STRIPE_SEAT_PRICE_YEARLY_ID=
# Signing secret (whsec_...) of the webhook endpoint -> /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Development only: "true" lets outside accounts use the app without a subscription.
# Ignored entirely when NODE_ENV=production.
BILLING_DEV_BYPASS=

# ── Third-party APIs (routes return 503 / an error when missing) ─────────────
ANTHROPIC_API_KEY=
USDA_FDC_API_KEY=
BRAVE_SEARCH_API_KEY=
